# Public Sanity configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=tbqxupiq
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_STUDIO_URL=/studio

# Server-only Viewer token required by Sanity Draft Mode
SANITY_API_READ_TOKEN=

# Server-only secret used to validate Sanity cache revalidation webhooks
SANITY_REVALIDATE_SECRET=

# Server-only credentials for the hora Calendar GA4 web data stream. Used to
# join server-confirmed newsletter signups to an existing browser session;
# never expose either value to the browser.
GA_API_SECRET=
GA_MEASUREMENT_ID=

# Sandbox-only Direct web billing. The public RevenueCat Web key is intentionally
# served to the browser by /api/billing/config only after the sandbox guard is
# checked. Never place an appl_ native key here.
WEB_BILLING_PUBLIC_API_KEY=
WEB_BILLING_ENVIRONMENT=sandbox

# Google OpenID Connect client ID. The same value is used by the browser to
# request an ID token and by the server to validate its audience.
GOOGLE_OAUTH_CLIENT_ID=

# Injected by a Vercel Marketplace Postgres integration (for new projects this
# is typically Neon). This is server-only and must never use NEXT_PUBLIC_.
DATABASE_URL=
