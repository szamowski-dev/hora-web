# Public Sanity configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=tbqxupiq
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_STUDIO_URL=/studio

# Public PostHog configuration for browser analytics.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-only Viewer token required by Sanity Draft Mode
SANITY_API_READ_TOKEN=

# Server-only secret used to validate Sanity cache revalidation webhooks
SANITY_REVALIDATE_SECRET=

# Server-only credentials for the hora Calendar GA4 web data stream. Used to
# join server-confirmed newsletter signups to an existing browser session;
# never expose either value to the browser.
GA_API_SECRET=
GA_MEASUREMENT_ID=

# Native Google OpenID Connect audiences accepted by POST /api/direct/identity.
# List the OAuth client IDs used by Direct, Mac App Store, and iOS.
GOOGLE_OAUTH_NATIVE_CLIENT_IDS=

# Server-only, versioned 32-byte HMAC key encoded as exactly 64 hex characters.
# Never expose it through NEXT_PUBLIC_ or replace it without an identity migration.
DIRECT_IDENTITY_HMAC_KEY_V1=

# Private HTTPS origin and dedicated server-to-server secret used by
# POST /api/direct/push/device to register Direct APNs tokens with hora-worker.
# Do not reuse DEVICE_REGISTRATION_SECRET or expose either value through NEXT_PUBLIC_.
DIRECT_PUSH_WORKER_URL=
DIRECT_PUSH_WORKER_SECRET=

# Public R2 custom domain used by GET /download/direct/. The resolver still
# enforces downloads.horacal.app and immutable Direct release paths in code.
DIRECT_DOWNLOAD_BASE_URL=https://downloads.horacal.app
