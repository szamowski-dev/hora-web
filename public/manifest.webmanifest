      "src": "/assets/brand/favicon-32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/brand/apple-touch-icon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/brand/hora-icon.png",
      "sizes": "120x120",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
